{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "file": {
      "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
    },
    "console": {
      "format": "%(asctime)s - %(message)s"
    }
  },
  "handlers": {
    "file": {
      "class": "logging.FileHandler",
      "filename": "prompter.log",
      "formatter": "file",
      "level": "DEBUG"
    },
    "console": {
      "class": "logging.StreamHandler",
      "formatter": "console",
      "level": "INFO"
    }
  },
  "root": {
    "level": "DEBUG",
    "handlers": ["file", "console"]
  }
}
